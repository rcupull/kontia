{
  "name": "kontia",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kontia-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kontia-db --remote",
    "db:restore:local-from-remote": "sh scripts/restore-local-from-remote.sh",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@hono/zod-validator": "0.8.0",
    "@radix-ui/react-popover": "1.1.23",
    "chart.js": "4.5.1",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "hono": "4.12.30",
    "lucide-react": "1.24.0",
    "react-hook-form": "7.83.0",
    "react": "19.2.7",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.2.7",
    "react-date-range": "2.0.1",
    "react-router-dom": "7.18.1",
    "sql.js": "1.13.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260714.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-date-range": "1.4.10",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "6.0.3",
    "prettier": "3.9.5",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "4.110.0"
  }
}
